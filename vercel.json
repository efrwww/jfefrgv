{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist/web",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/flow", "destination": "/api/flow-root" },
    { "source": "/deploy", "destination": "/index.html" },
    { "source": "/consumer", "destination": "/index.html" },
    { "source": "/merchant", "destination": "/index.html" },
    { "source": "/analysis", "destination": "/index.html" }
  ]
}
